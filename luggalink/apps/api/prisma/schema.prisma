// LuggaLink database schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  SENDER
  TRAVELER
  BOTH
  ADMIN
}

enum TripStatus {
  DRAFT
  ACTIVE
  BOOKED
  COMPLETED
  CANCELLED
}

enum ItemCategory {
  ELECTRONICS
  DOCUMENTS
  CLOTHING
  FOOD
  COSMETICS
  OTHER
}

enum ItemRequestStatus {
  PENDING
  MATCHED
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  DISPUTED
  CANCELLED
}

enum EscrowStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
  FROZEN
}

enum BookingStatus {
  PENDING_TRAVELER
  ACCEPTED
  REJECTED
  ACTIVE
  COMPLETED
  DISPUTED
  CANCELLED
}

enum HandoffStage {
  SENDER_POSTED
  TRAVELER_PICKUP
  QR_SCAN_DEPARTURE
  QR_SCAN_ARRIVAL
  RECIPIENT_CONFIRMED
}

enum DisputeReason {
  ITEM_NOT_RECEIVED
  ITEM_DAMAGED
  WRONG_ITEM
  TRAVELER_NO_SHOW
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_SENDER
  RESOLVED_TRAVELER
  RESOLVED_SPLIT
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_ACCEPTED
  PAYMENT_HELD
  ITEM_POSTED
  QR_SCANNED
  DELIVERED
  DISPUTE_OPENED
  PAYOUT_SENT
  BOOKING_REJECTED
  PAYMENT_FAILED
}

// ─────────────────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String

  firstName String
  lastName  String
  avatarUrl String?
  country   String?
  postalAddress String?

  role UserRole @default(SENDER)

  trustScore       Float @default(5.0)
  totalTrips       Int   @default(0)
  totalDeliveries  Int   @default(0)

  isPhoneVerified Boolean @default(false)
  isIdVerified    Boolean @default(false)
  isFaceVerified  Boolean @default(false)

  stripeCustomerId String?
  stripeAccountId  String?

  expoPushToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips               Trip[]             @relation("TravelerTrips")
  itemRequests        ItemRequest[]      @relation("SenderItemRequests")
  bookingsAsSender    Booking[]          @relation("SenderBookings")
  bookingsAsTraveler  Booking[]          @relation("TravelerBookings")
  handoffLogs         HandoffLog[]       @relation("HandoffPerformedBy")
  messages            Message[]          @relation("MessageSender")
  reviewsWritten      Review[]           @relation("ReviewerReviews")
  reviewsReceived     Review[]           @relation("RevieweeReviews")
  disputesOpened      Dispute[]          @relation("DisputeOpenedBy")
  notifications       Notification[]     @relation("UserNotifications")

  @@index([role])
  @@map("users")
}

model Trip {
  id String @id @default(uuid())

  travelerId String
  traveler   User   @relation("TravelerTrips", fields: [travelerId], references: [id])

  originCity      String
  originCountry   String
  originIataCode  String

  destinationCity     String
  destinationCountry  String
  destinationIataCode String

  departureDate DateTime
  arrivalDate   DateTime

  flightNumber String?

  availableLbs Float
  pricePerLb   Float

  status TripStatus @default(DRAFT)

  allowedCategories String[]

  boardingPassUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemRequests ItemRequest[]
  bookings     Booking[]

  @@index([travelerId])
  @@index([status])
  @@index([departureDate])
  @@index([originCountry, destinationCountry])
  @@map("trips")
}

model ItemRequest {
  id String @id @default(uuid())

  senderId String
  sender   User   @relation("SenderItemRequests", fields: [senderId], references: [id])

  tripId String?
  trip   Trip?   @relation(fields: [tripId], references: [id])

  name        String
  description String

  category ItemCategory

  weightLbs        Float
  declaredValueUsd Float

  photoUrls String[]

  status ItemRequestStatus @default(PENDING)

  recipientName    String
  recipientPhone   String
  recipientAddress String
  recipientCountry String

  trackingNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking?

  @@index([senderId])
  @@index([tripId])
  @@index([status])
  @@map("item_requests")
}

model Booking {
  id String @id @default(uuid())

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id])

  itemRequestId String      @unique
  itemRequest   ItemRequest @relation(fields: [itemRequestId], references: [id])

  senderId String
  sender   User   @relation("SenderBookings", fields: [senderId], references: [id])

  travelerId String
  traveler   User   @relation("TravelerBookings", fields: [travelerId], references: [id])

  agreedPricePerLb  Float
  totalPriceUsd     Float
  platformFeeUsd    Float
  travelerPayoutUsd Float

  hasInsurance     Boolean @default(false)
  insuranceFeeUsd  Float   @default(0)

  stripePaymentIntentId String?
  stripeTransferId      String?

  customsFormUrl String?

  escrowStatus EscrowStatus @default(PENDING)

  qrSealCode String @unique

  status BookingStatus @default(PENDING_TRAVELER)

  travelerAcceptedAt DateTime?
  itemPostedAt       DateTime?
  itemPickedUpAt     DateTime?
  deliveredAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  handoffLogs HandoffLog[]
  messages    Message[]
  reviews     Review[]
  disputes    Dispute[]

  @@index([tripId])
  @@index([senderId])
  @@index([travelerId])
  @@index([status])
  @@index([escrowStatus])
  @@map("bookings")
}

model HandoffLog {
  id String @id @default(uuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  stage HandoffStage

  photoUrls String[]

  scannedQrCode String?
  signatureUrl  String?

  performedByUserId String
  performedBy       User   @relation("HandoffPerformedBy", fields: [performedByUserId], references: [id])

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([stage])
  @@index([performedByUserId])
  @@map("handoff_logs")
}

model Message {
  id String @id @default(uuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id])

  body   String
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([senderId])
  @@map("messages")
}

model Review {
  id String @id @default(uuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  reviewerId String
  reviewer   User   @relation("ReviewerReviews", fields: [reviewerId], references: [id])

  revieweeId String
  reviewee   User   @relation("RevieweeReviews", fields: [revieweeId], references: [id])

  rating  Int
  comment String?

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([reviewerId])
  @@index([revieweeId])
  @@map("reviews")
}

model Dispute {
  id String @id @default(uuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  openedByUserId String
  openedBy       User   @relation("DisputeOpenedBy", fields: [openedByUserId], references: [id])

  reason DisputeReason

  description  String
  evidenceUrls String[]

  status DisputeStatus @default(OPEN)

  resolutionNote String?

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([bookingId])
  @@index([openedByUserId])
  @@index([status])
  @@map("disputes")
}

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id])

  type NotificationType

  title String
  body  String

  data Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([type])
  @@map("notifications")
}

model AuditLog {
  id String @id @default(uuid())

  entity     String
  entityId   String
  action     String
  fromStatus String?
  toStatus   String?

  performedByUserId String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([performedByUserId])
  @@map("audit_logs")
}
